<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>3</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>Release\UMM\Mods\EnemyAIEnhancement\</OutputPath>
  </PropertyGroup>
  <Import Project="LocalBroforcePath.props" Condition="Exists('LocalBroforcePath.props')" />
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <Reference Include="UnityEngine"><HintPath>$(BroforceManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BroforceManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(BroforceManagedPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(BroforceManagedPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(BroforceManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(UnityModManagerPath)\UnityModManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(UnityModManagerPath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
