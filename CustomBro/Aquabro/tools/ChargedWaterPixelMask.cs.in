// 由 export_water_effects.lua 与蓄力水花图集同时生成，坐标从左上角开始。
using System;

namespace AquabroMod
{
    internal static class ChargedWaterPixelMask
    {
        private static readonly byte[][] Frames = {
@FRAMES@
        };

        internal static bool IsVisible(int frame, int x, int y)
        {
            if (frame < 0 || frame >= Frames.Length || x < 0 || x >= 64 || y < 0 || y >= 64) return false;
            int bit = y * 64 + x;
            return (Frames[frame][bit / 8] & (1 << (bit % 8))) != 0;
        }
    }
}
