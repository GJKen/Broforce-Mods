# Machine-specific Broforce build paths.
/BroforceBugFix/LocalBroforcePath.props
/CustomMapMultiplayer/LocalBroforcePath.props

# Locally supplied Assembly-CSharp candidate; do not publish the game assembly.
/CustomMapMultiplayer/AssemblyCSharpChineseInputSwitch/payload/Assembly-CSharp-ChineseInput.candidate.dll

# Local reverse-engineering reference; never publish extracted game source.
/Broforce_src/Broforce-Source/

# 从游戏 assetbundle 导出的官方贴图/音频,仅供自用参考,不随仓库分发。
# 内容清单与重导方法见 Broforce_src/GameAssets/README.md
/Broforce_src/GameAssets

# Custom bro local build settings, working backups and generated Python caches.
/CustomBro/*/LocalBroforcePath.props
/CustomBro/*/backups/
/CustomBro/*/tools/archive/**/*.dll
**/__pycache__/
*.py[cod]
