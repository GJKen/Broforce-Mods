<Project>
  <PropertyGroup>
    <!-- Set these paths locally; do not commit real machine-specific paths. -->
    <!-- Replace these example paths with locations from your own installation. -->
    <BroforceManagedPath>C:\Path\To\Broforce\Broforce_beta_Data\Managed</BroforceManagedPath>
    <UnityModManagerPath>C:\Path\To\UMM\Core</UnityModManagerPath>
    <RocketLibPath>C:\Path\To\UMM\Mods\RocketLib-RocketLib\RocketLib\RocketLib.dll</RocketLibPath>

    <!-- BroMaker dll and BroMaker_Storage target folder (deploy destination). -->
    <BroMakerLibPath>C:\Path\To\UMM\Mods\BroMaker-BroMaker\BroMakerLib\BroMakerLib.dll</BroMakerLibPath>
    <!-- Newtonsoft.Json.dll ships inside the RocketLib package folder -->
    <NewtonsoftJsonPath>C:\Path\To\UMM\Mods\RocketLib-RocketLib\RocketLib\Newtonsoft.Json.dll</NewtonsoftJsonPath>
    <!-- Optional semicolon-separated Unity modules, e.g. PhysicsModule.dll;ImageConversionModule.dll -->
    <AdditionalReferencePaths></AdditionalReferencePaths>
    <BroMakerStoragePath>C:\Path\To\UMM\BroMaker_Storage</BroMakerStoragePath>

    <!-- Bro folder name inside BroMaker_Storage; must contain the .mod.json, bro .json and sprites. -->
    <BroStorageFolderName>MyBro</BroStorageFolderName>
  </PropertyGroup>
</Project>
